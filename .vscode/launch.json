            // Se abre en una consola aparte para poder escribir en el menu.
            "name": "Centro logistico",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}\\Procesos\\001-Programacion multiproceso\\010-Entrega\\002-Proyecto\\build\\centro_logistico.exe",
            "args": [],
