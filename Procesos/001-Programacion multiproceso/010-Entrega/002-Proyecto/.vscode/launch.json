{
    // F5      -> compila y ejecuta con depurador (puntos de interrupcion)
    // Ctrl+F5 -> compila y ejecuta sin depurar
    // El programa se abre en una consola aparte para poder escribir en el menu.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Centro logistico",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}\\build\\centro_logistico.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": true,
            "MIMode": "gdb",
            "miDebuggerPath": "${env:LOCALAPPDATA}\\Microsoft\\WinGet\\Packages\\BrechtSanders.WinLibs.POSIX.UCRT_Microsoft.Winget.Source_8wekyb3d8bbwe\\mingw64\\bin\\gdb.exe",
            "setupCommands": [
                {
                    "description": "Habilitar impresion con formato para gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Centro logistico: compilar"
        }
    ]
}
